<div class="auth-page">
  <div class="auth-card">
    <h1 class="auth-title">新規登録</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

      <div class="auth-form-group">
        <%= f.label :name, class: "auth-label" do %>
          ユーザー名<span class="auth-required">*</span>
        <% end %>
        <%= f.text_field :name, autocomplete: "name",
              placeholder: "ユーザー名を入力", class: "auth-input" %>
      </div>

      <div class="auth-form-group">
        <%= f.label :email, class: "auth-label" do %>
          メールアドレス<span class="auth-required">*</span>
        <% end %>
        <%= f.email_field :email, autocomplete: "email",
              placeholder: "メールアドレスを入力", class: "auth-input" %>
      </div>

      <div class="auth-form-group">
        <%= f.label :password, class: "auth-label" do %>
          パスワード<span class="auth-required">*</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
              placeholder: "パスワードを入力", class: "auth-input" %>
      </div>

      <div class="auth-form-group">
        <%= f.label :password_confirmation, class: "auth-label" do %>
          確認用パスワード<span class="auth-required">*</span>
        <% end %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              placeholder: "確認用パスワードを入力", class: "auth-input" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "新しいアカウントを作成", class: "auth-btn auth-btn--primary" %>
      </div>
    <% end %>

    <%= link_to "アカウントをお持ちの方はログイン", new_session_path(resource_name),
          class: "auth-btn auth-btn--secondary" %>
  </div>
</div>
