<section class="settings">
  <div class="settings__container">
    <%= render "users/settings_header", active_tab: :account %>

    <div class="settings-card">
      <div class="settings-card__header">
        <h2 class="settings-card__heading">アカウント</h2>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "account-edit" }) do |f| %>

        <div class="account-edit__row">
          <div class="account-edit__label">メールアドレス</div>
          <div class="account-edit__value">
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  class: "account-edit__input",
                  placeholder: "メールアドレスを入力してください" %>

            <% if resource.errors[:email].any? %>
              <div class="account-edit__error">
                <%= resource.errors.full_messages_for(:email).first %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="account-edit__row account-edit__row--help">
          <div class="account-edit__label">
            変更後パスワード
            <div class="account-edit__note">※変更する場合のみ</div>
          </div>
          <div class="account-edit__value">
            <%= f.password_field :password, autocomplete: "new-password",
                  class: "account-edit__input",
                  placeholder: "変更後パスワードを入力" %>

            <% if @minimum_password_length %>
              <div class="account-edit__hint"><%= @minimum_password_length %>文字以上</div>
            <% end %>

            <% if resource.errors[:password].any? %>
              <div class="account-edit__error">
                <%= resource.errors.full_messages_for(:password).first %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="account-edit__row account-edit__row--help">
          <div class="account-edit__label">
            確認用パスワード
            <div class="account-edit__note">※変更する場合のみ</div>
          </div>
          <div class="account-edit__value">
            <%= f.password_field :password_confirmation, autocomplete: "new-password",
                  class: "account-edit__input",
                  placeholder: "変更後パスワードを入力" %>

            <% if resource.errors[:password_confirmation].any? %>
              <div class="account-edit__error">
                <%= resource.errors.full_messages_for(:password_confirmation).first %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="account-edit__row">
          <div class="account-edit__label">現在のパスワード</div>
          <div class="account-edit__value">
            <%= f.password_field :current_password, autocomplete: "current-password",
                  class: "account-edit__input",
                  placeholder: "現在のパスワードを入力" %>

            <% if resource.errors[:current_password].any? %>
              <div class="account-edit__error">
                <%= resource.errors.full_messages_for(:current_password).first %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="account-edit__actions">
          <%= f.submit "保存", class: "account-edit__submit" %>
          <%= link_to "キャンセル", users_account_path, class: "account-edit__cancel" %>
        </div>
      <% end %>
    </div>
  </div>
</section>