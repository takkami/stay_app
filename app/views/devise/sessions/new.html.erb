<div class="auth-page">
  <div class="auth-card">
    <h1 class="auth-title">ログイン</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="auth-form-group">
        <%= f.label :email, "メールアドレス", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              placeholder: "メールアドレスを入力", class: "auth-input" %>
      </div>

      <div class="auth-form-group">
        <%= f.label :password, "パスワード", class: "auth-label" %>
        <%= f.password_field :password, autocomplete: "current-password",
              placeholder: "パスワードを入力", class: "auth-input" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "ログイン", class: "auth-btn auth-btn--primary" %>
      </div>
    <% end %>

    <%= link_to "新しいアカウントを作成", new_registration_path(resource_name),
          class: "auth-btn auth-btn--secondary" %>
  </div>
</div>
