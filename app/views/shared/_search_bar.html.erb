<div class="search-bar">
  <div class="search-bar__inner">
    <form class="search-bar__form" action="#" method="get">
      <div class="search-bar__field search-bar__field--area">
        <span class="search-bar__icon" aria-hidden="true">📍</span>
        <input
          type="text"
          name="area"
          class="search-bar__input"
          placeholder="エリア名を入力"
        >
      </div>

      <div class="search-bar__field search-bar__field--keyword">
        <span class="search-bar__icon" aria-hidden="true">🔍</span>
        <input
          type="text"
          name="keyword"
          class="search-bar__input"
          placeholder="キーワード名を入力"
        >
      </div>

      <button type="submit" class="search-bar__submit">検索</button>
    </form>
  </div>
</div>
