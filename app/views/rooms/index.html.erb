<h1>施設一覧（自分が登録した施設）</h1>

<p><%= link_to "施設を新規登録", new_room_path %></p>

<% @rooms.each do |room| %>
  <div style="border: 1px solid #ddd; padding: 12px; margin-bottom: 12px;">
    <p>
      <%= image_tag(room.image.attached? ? room.image : "default_room.png", width: 160) %>
    </p>

    <h2><%= link_to room.name, room_path(room) %></h2>
    <p><%= room.description %></p>
    <p>住所：<%= room.address %></p>
    <p>料金：<%= room.price %> 円 / 日</p>
    <p>作成日：<%= room.created_at.strftime("%Y/%m/%d") %></p>
  </div>
<% end %>
