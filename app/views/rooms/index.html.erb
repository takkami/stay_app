<section class="rooms-index">
  <div class="rooms-index__container">
    <header class="rooms-index__header">
      <h1 class="rooms-index__title">施設一覧（全ユーザー）</h1>
    </header>
    <ul>
      <% @rooms.each do |room| %>
        <li><%= link_to room.name, room_path(room) %></li>
      <% end %>
    </ul>
  </div>
</section>
