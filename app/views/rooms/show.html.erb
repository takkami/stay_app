<% content_for :sub_header do %>
  <%= render "shared/search_bar" %>
<% end %>

<section class="room-show">
  <div class="room-show__container">

    <div class="room-show__top">
      <%= link_to "← 戻る",
          (params[:return_to].presence || rooms_path),
          class: "room-show__back" %>
      <% if user_signed_in? && @room.user_id == current_user.id %>
        <%= link_to "✐ 編集", edit_room_path(@room, return_to: request.fullpath), class: "room-show__edit" %>
      <% end %>
    </div>

    <div class="room-show__content">
      <div class="room-show__media">
        <%= image_tag(
          @room.image.attached? ? @room.image : "default_room.png",
          class: "room-show__image",
          alt: @room.name
        ) %>
      </div>

      <div class="room-show__card">
        <div class="room-show__card-head">
          <div class="room-show__name"><%= @room.name %></div>
          <div class="room-show__price">
            <%= number_to_currency(@room.price, unit: "¥", precision: 0, format: "%u%n") %>〜
          </div>
        </div>
        <div class="room-show__address"><%= @room.address %></div>
        <div class="room-show__meta">
          <div class="room-show__stars" aria-label="5つ星">
            <% 5.times do %>
              <%= image_tag "star-icon.svg", class: "room-show__star", alt: "" %>
            <% end %>
          </div>
        </div>

        <div class="room-show__description">
          <%= simple_format(@room.description.to_s) %>
        </div>

        <% if user_signed_in? %>
          <%= form_with url: confirm_reservations_path,
              method: :post,
              scope: :reservation,
              local: true,
              data: { turbo: false } do |f| %>
            <%= f.hidden_field :room_id, value: @room.id %>

            <div class="room-show__reserve">
              <div class="room-show__reserve-grid">
                <div class="room-show__reserve-field">
                  <div class="room-show__reserve-label">チェックイン</div>
                  <%= f.date_field :check_in,
                      class: "room-show__reserve-input",
                      value: params.dig(:reservation, :check_in) %>
                </div>

                <div class="room-show__reserve-field">
                  <div class="room-show__reserve-label">チェックアウト</div>
                  <%= f.date_field :check_out,
                      class: "room-show__reserve-input",
                      value: params.dig(:reservation, :check_out) %>
                </div>

                <div class="room-show__reserve-field">
                  <div class="room-show__reserve-label">人数</div>
                  <div class="room-show__reserve-people">
                    <%= f.number_field :people,
                        class: "room-show__reserve-input",
                        min: 1,
                        value: (params.dig(:reservation, :people).presence || 1) %>
                    <span class="room-show__reserve-unit">人</span>
                  </div>
                </div>
              </div>
            </div>

            <%= f.submit "予約する", class: "room-show__reserve-btn" %>
          <% end %>
        <% else %>
          <%= link_to "ログイン", new_user_session_path, class: "room-show__reserve-btn" %>
        <% end %>

      </div>
    </div>

  </div>
</section>
