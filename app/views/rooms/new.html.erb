<h1>施設の新規登録</h1>

<% if @room.errors.any? %>
  <div style="border: 1px solid red; padding: 12px; margin-bottom: 12px;">
    <h3>入力エラーがあります</h3>
    <ul>
      <% @room.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @room do |f| %>
  <div>
    <label>施設名（必須）</label><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <label>施設詳細（必須）</label><br>
    <%= f.text_area :description %>
  </div>

  <div>
    <label>料金（必須 / 1円以上）</label><br>
    <%= f.number_field :price %>
  </div>

  <div>
    <label>住所（必須）</label><br>
    <%= f.text_field :address %>
  </div>

  <div>
    <label>施設画像</label><br>
    <%= f.file_field :image %>
  </div>

  <div style="margin-top: 12px;">
    <%= f.submit "登録する" %>
  </div>
<% end %>
